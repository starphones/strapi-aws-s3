{
  "kind": "collectionType",
  "collectionName": "answer_hub_guides",
  "info": {
    "singularName": "answer-hub-guide",
    "pluralName": "answer-hub-guides",
    "displayName": "Answer Hub Guide",
    "description": "An authored guide displayed in the storefront Answer Hub"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text", "required": true },
    "quickAnswer": { "type": "text", "required": true },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::answer-hub-category.answer-hub-category",
      "inversedBy": "guides",
      "required": true
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "answer-hub.section",
      "required": true
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "answer-hub.faq"
    },
    "metadata": {
      "type": "component",
      "repeatable": false,
      "component": "metadata.metadata",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "relatedGuides": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::answer-hub-guide.answer-hub-guide"
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "featured": { "type": "boolean", "default": false },
    "rank": { "type": "integer", "default": 0 },
    "author": { "type": "string" },
    "readTime": { "type": "string" }
  }
}
